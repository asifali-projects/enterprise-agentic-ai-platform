APP_NAME=Enterprise Agentic AI Operating Platform
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-random-32-plus-character-secret
ACCESS_TOKEN_MINUTES=60
DATABASE_URL=postgresql+asyncpg://agentic:agentic@postgres:5432/agentic
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["http://localhost:5173"]
DEMO_TTL_MINUTES=120
INVITATION_TTL_HOURS=48
RUN_TIMEOUT_SECONDS=120
MAX_CONCURRENCY=8
LLM_PROVIDER=local
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=local-deterministic

TOOL_TIMEOUT_SECONDS=30
TOOL_MAX_RETRIES=2
TOOL_ALLOWED_HOSTS=[]
OTEL_ENABLED=true
OTEL_EXPORTER_ENDPOINT=
QDRANT_URL=http://qdrant:6333
MEMORY_VECTOR_SIZE=64
